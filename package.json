{
	"name": "@tihn/bun-guard",
	"description": "A security scanner for Bun's package manager",
	"version": "1.4.0",
	"author": "Andrin Haldner",
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AHaldner/bun-guard.git"
	},
	"keywords": [
		"bun",
		"security",
		"provider"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"prepack": "bun run build",
		"package:check": "bun scripts/package-check.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . && tsc --noEmit",
		"lint:fix": "eslint . --fix",
		"test": "bun test",
		"bench:scan": "bun run bench/scan.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.13",
		"@typescript-eslint/eslint-plugin": "^8.59.0",
		"@typescript-eslint/parser": "^8.59.0",
		"eslint": "^10.2.1",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3"
	}
}
