{
	"name": "@tihn/bun-guard",
	"description": "A security scanner for Bun's package manager",
	"version": "1.4.1",
	"author": "Andrin Haldner",
	"license": "MIT",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AHaldner/bun-guard.git"
	},
	"keywords": [
		"bun",
		"security",
		"security-scanner",
		"bun-security-scanner",
		"osv",
		"vulnerability-scanner",
		"dependency-scanner"
	],
	"scripts": {
		"build": "tsdown",
		"prepack": "bun run build",
		"package:check": "bun scripts/package-check.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware && tsc --noEmit",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "bun test",
		"bench:scan": "bun run bench/scan.ts"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"oxfmt": "^0.48.0",
		"oxlint": "^1.63.0",
		"oxlint-tsgolint": "^0.22.1",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3"
	}
}
